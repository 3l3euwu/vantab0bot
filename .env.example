# ─────────────────────────────────────────────────────────────────────────────
#  Vantab · example configuration
#  Copy to .env  →  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Credentials file (recommended) ───────────────────────────────────────────
# Vantab reads `tkn.txt` next to bot.py first:
#     discord-token=...
#     provider=gemini
#     model=gemini-3.1-flash-lite
#     api-key=...
# Values in that file win over everything below.
# CREDENTIALS_FILE=tkn.txt

# ── Discord ───────────────────────────────────────────────────────────────────
# https://discord.com/developers/applications → Bot → Reset Token
# Both privileged intents must be enabled: SERVER MEMBERS + MESSAGE CONTENT.
DISCORD_TOKEN=

# Optional: comma-separated Discord user IDs that can use owner-only commands.
OWNER_IDS=

# Prefix used when a server has not set its own (`~setprefix`).
DEFAULT_PREFIX=~

# Optional: sync slash commands instantly to this guild while developing.
DEV_GUILD_ID=

# Where the SQLite database lives.
DATABASE_PATH=data/vantab.db

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Presence: {guilds} is replaced with the server count.
STATUS_TEXT=over {guilds} servers · ~{question}
ACTIVITY_TYPE=watching

# ── AI ────────────────────────────────────────────────────────────────────────
AI_ENABLED=true

# gemini | openai | openrouter | groq | together | deepinfra | mistral |
# ollama | lmstudio | custom
AI_PROVIDER=gemini

# Any OpenAI-compatible endpoint. Presets fill this in automatically.
# Gemini's OpenAI-compatible endpoint:
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite

# Tried in order when the primary model is overloaded (503/429).
# Gemini preset already defaults to gemini-3.1-flash, gemini-2.5-flash,
# gemini-2.5-flash-lite.
# AI_FALLBACK_MODELS=gemini-3.1-flash,gemini-2.5-flash

AI_TEMPERATURE=0.8
AI_MAX_TOKENS=1200
AI_TIMEOUT=120
AI_STREAM=true
AI_VISION=true
AI_HISTORY_LIMIT=24
AI_HISTORY_TTL_DAYS=14
AI_COOLDOWN=2

# Optional: extra HTTP headers as JSON, e.g. {"X-Custom":"value"}
# AI_EXTRA_HEADERS={}

# Persona / style of the AI. Edit prompts/persona.json to add more styles.
PERSONA_FILE=prompts/persona.json
# Active style. Shipped: "elee" (cute lowercase kaomoji girl) and "normal".
AI_STYLE=elee
# Optional: override the greeting line sent when a conversation starts.
# AI_GREETING=hewoooooo~ cha vaaa~ ? :3

# Optional: replace the entire system prompt (raw text or file).
# AI_SYSTEM_PROMPT_FILE=prompts/custom.md
# AI_SYSTEM_PROMPT=You are …

# ── Moderation ────────────────────────────────────────────────────────────────
DEFAULT_MUTE_MINUTES=10
MAX_TIMEOUT_MINUTES=40320
DM_ON_PUNISH=true
ANTINUKE_POLL_SECONDS=6

# ── Local models (examples) ───────────────────────────────────────────────────
# AI_PROVIDER=ollama
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llama3.1
